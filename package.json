{
  "name": "transcripts-fyi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:run": "tsx --env-file=${ENV_FILE:-.env.local} scripts/smoke/run.ts",
    "smoke:storage": "tsx --env-file=${ENV_FILE:-.env.local} scripts/smoke/storage.ts",
    "db:generate": "node --env-file=${ENV_FILE:-.env.local} node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=${ENV_FILE:-.env.local} node_modules/drizzle-kit/bin.cjs migrate",
    "vercel-build": "drizzle-kit migrate && next build",
    "distill": "tsx --env-file=${ENV_FILE:-.env.local} scripts/distill.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "e2e": "playwright test",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run test && npm run knip",
    "reconcile": "tsx --env-file=${ENV_FILE:-.env.local} scripts/reconcile.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "gc": "tsx --env-file=${ENV_FILE:-.env.local} scripts/gc.ts",
    "tickers": "tsx --env-file=${ENV_FILE:-.env.local} scripts/tickers.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.33.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
