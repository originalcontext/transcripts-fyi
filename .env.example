# --- LLM ---
ANTHROPIC_API_KEY=
# whsec_… from Console → Manage → Webhooks (shown once)
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# --- Postgres (Neon via Vercel) ---
DATABASE_URL=

# --- Redis (Upstash via Vercel) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Transcript source (TBD) ---
TRANSCRIPT_API_KEY=

# --- Smoke test / webhook routing ---
# Which deployment this process is: "prod" or "dev". Defaults from VERCEL_ENV.
# Set to "dev" in .env.local so the local server answers dev-targeted sessions.
SMOKE_TARGET=
