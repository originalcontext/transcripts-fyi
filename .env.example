# Copy to .env.local for dev (`vercel env pull .env.local` fills most of these).
# Never NEXT_PUBLIC_ anything here.

# --- Anthropic ---
ANTHROPIC_API_KEY=
# whsec_… from Console → Manage → Webhooks (shown once); one per endpoint (dev/prod)
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# --- Storage (Vercel integrations) ---
# Neon, per environment. The app uses this pooled URL over HTTP.
DATABASE_URL=
# Upstash, shared across environments; keys are prefixed by deploy target.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Market data ---
FMP_API_KEY=
MASSIVE_API_KEY=

# --- Auth ---
# Invite code; also the session-cookie secret. Rotate to log everyone out.
INVITE_CODE=
# Optional. Logging in with it also marks the session admin (CMA-backed trace pane). Unset = everyone is admin.
ADMIN_INVITE_CODE=

# --- Local only ---
# "dev" so this process answers dev-targeted sessions. On Vercel it derives from VERCEL_ENV.
SMOKE_TARGET=
