# --- LLM ---
ANTHROPIC_API_KEY=
# whsec_… from Console → Manage → Webhooks (shown once)
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# --- Transcript source (TBD) ---
TRANSCRIPT_API_KEY=

# --- Smoke test / webhook routing ---
# Which deployment this process is: "prod" or "dev". Defaults from VERCEL_ENV.
# Set to "dev" in .env.local so the local server answers dev-targeted sessions.
SMOKE_TARGET=

# --- Market data ---
FMP_API_KEY=
MASSIVE_API_KEY=

# Neon (per environment, via Vercel integration). App uses the pooled HTTP URL.
DATABASE_URL=
# Upstash (shared across environments; keys are prefixed by deploy target)
KV_REST_API_URL=
KV_REST_API_TOKEN=
